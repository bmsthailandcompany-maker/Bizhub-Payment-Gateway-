# โดเมนจริงของเกตเวย์ (ใช้กับ docker-compose: Caddy ขอใบรับรอง HTTPS ให้อัตโนมัติ)
DOMAIN=pay.example.com

# พอร์ตและ URL สาธารณะของเกตเวย์ (ใช้สร้างลิงก์หน้าชำระเงิน; docker-compose ตั้งให้จาก DOMAIN)
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# โทเคนสำหรับเรียก Admin API (ต้องตั้งให้ยาวและสุ่ม)
ADMIN_TOKEN=change-me-to-a-long-random-string

# บังคับให้บัญชีแอดมินทุกคนตั้งค่ายืนยันตัวตน 2 ชั้น (แนะนำให้เปิดเมื่อใช้งานจริง)
ADMIN_REQUIRE_2FA=false

# ที่เก็บฐานข้อมูล SQLite และไฟล์สลิป
DATA_DIR=./data

# อายุหน้าชำระเงินตั้งต้น (วินาที)
DEFAULT_PAYMENT_TTL_SECONDS=900

# บัตรเครดิตโหมด live ผ่าน Omise (Opn Payments) — เว้นว่างไว้ได้ถ้ายังไม่ใช้
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# ตรวจสลิปอัตโนมัติสำหรับโหมด live: easyslip | slipok | none
# (โหมดทดสอบใช้ตัวจำลองเสมอ ถ้าเป็น none สลิปโหมด live จะรอร้านค้ายืนยันเอง)
SLIP_VERIFIER=none
EASYSLIP_API_KEY=
# EASYSLIP_BASE_URL=https://developer.easyslip.com/api/v1
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# สำรองฐานข้อมูลอัตโนมัติไว้ที่ DATA_DIR/backups ทุกกี่ชั่วโมง (0 = ปิด) และเก็บไว้กี่ไฟล์
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ลบรูปสลิปของรายการที่ปิดแล้วเมื่อเกินกี่วัน (0 = เก็บไว้ตลอด) ตั้งให้สอดคล้องกับนโยบาย PDPA และการเก็บหลักฐานทางบัญชีของบริษัท
SLIP_RETENTION_DAYS=0

# สำรองข้อมูลนอกเครื่อง: ส่งไฟล์สำรองฐานข้อมูลและรูปสลิปไปเก็บที่ storage แบบ S3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
# เว้นว่างไว้ = ไม่ส่ง (แนะนำให้ตั้งก่อนใช้งานจริง)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=bizhub

# ชื่อและช่องทางติดต่อผู้ให้บริการระบบ แสดงในหน้านโยบายความเป็นส่วนตัว /privacy
OPERATOR_NAME=
OPERATOR_CONTACT=
