{
  "name": "bizhub-payment-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-merchant payment gateway: PromptPay QR, card, and bank transfer with slip upload",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "create-merchant": "tsx scripts/create-merchant.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
